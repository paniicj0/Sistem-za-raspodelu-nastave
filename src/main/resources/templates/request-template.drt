template header

assistantName
subjectName
priority

package rules

import sbnz.szrn.model.Candidate;

template "specificRequestTemplate"

rule "Template specific request @{assistantName} -> @{subjectName}"
salience 65
when
    $c : Candidate(
        specificRequestApplied == false,
        assistant.name == "@{assistantName}",
        subject.name == "@{subjectName}"
    )
then
    int bonus = @{priority} * 15;

    $c.addScore(
        bonus,
        "Template zahtev prioriteta @{priority}."
    );

    $c.setSpecificRequestApplied(true);

    update($c);

    System.out.println(
        "[TEMPLATE RULE] @{assistantName} -> @{subjectName}"
        + " | bonus = "
        + bonus
        + " | score = "
        + $c.getScore()
    );
end

end template