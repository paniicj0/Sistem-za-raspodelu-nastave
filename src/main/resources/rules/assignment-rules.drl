package rules

import sbnz.szrn.model.ValidationMessage;
import sbnz.szrn.model.Assistant;
import sbnz.szrn.model.Subject;
import sbnz.szrn.model.Preference;
import sbnz.szrn.model.PreviousAssignment;
import sbnz.szrn.model.SpecificRequest;
import sbnz.szrn.model.Candidate;
import sbnz.szrn.model.AssignmentResult;

rule "High preference creates candidate"
salience 100
when
    $p : Preference(
        $assistant : assistant,
        $subject : subject,
        grade == 5
    )

    not Candidate(
        assistant == $assistant,
        subject == $subject
    )
then
    Candidate candidate = new Candidate(
        0,
        $assistant,
        $subject,
        50,
        "Visoka preferenca."
    );

    insert(candidate);

    System.out.println(
        "[RULE] High preference creates candidate: "
        + $assistant.getName()
        + " -> "
        + $subject.getName()
    );
end


rule "Medium preference creates candidate"
salience 90
when
    $p : Preference(
        $assistant : assistant,
        $subject : subject,
        grade >= 3,
        grade <= 4
    )

    not Candidate(
        assistant == $assistant,
        subject == $subject
    )
then
    Candidate candidate = new Candidate(
        0,
        $assistant,
        $subject,
        25,
        "Srednja preferenca."
    );

    insert(candidate);

    System.out.println(
        "[RULE] Medium preference creates candidate: "
        + $assistant.getName()
        + " -> "
        + $subject.getName()
    );
end


rule "Previous assignment increases score"
salience 50
when
    $c : Candidate(
        previousAssignmentApplied == false,
        $assistant : assistant,
        $subject : subject
    )

    PreviousAssignment(
        assistant == $assistant,
        subject == $subject
    )
then
    $c.addScore(
        20,
        "Asistent je prethodno drzao predmet."
    );

    $c.setPreviousAssignmentApplied(true);

    update($c);

    System.out.println(
        "[RULE] Previous assignment increases score: "
        + $assistant.getName()
        + " -> "
        + $subject.getName()
        + " | score = "
        + $c.getScore()
    );
end


rule "Overload penalty"
salience 40
when
    $c : Candidate(
        overloadPenaltyApplied == false,
        $assistant : assistant,
        $subject : subject
    )

    eval($assistant.getTotalLoad() + $subject.getTotalHours() > $assistant.getTargetLoad())
then
    $c.addScore(
        -30,
        "Dodela bi prekoracila ciljano opterecenje."
    );

    $c.setOverloadPenaltyApplied(true);

    update($c);

    System.out.println(
        "[RULE] Overload penalty: "
        + $assistant.getName()
        + " -> "
        + $subject.getName()
        + " | score = "
        + $c.getScore()
    );
end

rule "Best candidate gets small subject"
salience -10
when
    $c : Candidate(
        $assistant : assistant,
        $subject : subject,
        $score : score
    )

    eval(!$subject.isLargeSubject())

    not Candidate(
        subject == $subject,
        score > $score
    )

    not AssignmentResult(
        subject == $subject
    )
then
    AssignmentResult result = new AssignmentResult(
        0,
        $assistant,
        $subject,
        $subject.getTotalHours(),
        $score,
        "Najbolji kandidat za manji predmet. " + $c.getExplanation()
    );

    $assistant.addLoad($subject.getSemester(), $subject.getTotalHours());
    update($assistant);

    insert(result);

    System.out.println(
        "[RESULT] "
        + $assistant.getName()
        + " dobija manji predmet "
        + $subject.getName()
        + " | hours = "
        + $subject.getTotalHours()
        + " | score = "
        + $score
    );
end

rule "Best candidate gets first part of large subject"
salience -10
when
    $c : Candidate(
        $assistant : assistant,
        $subject : subject,
        $score : score
    )

    eval($subject.isLargeSubject())

    not Candidate(
        subject == $subject,
        score > $score
    )

    not AssignmentResult(
        subject == $subject,
        assistant == $assistant
    )
then
    int hours = $subject.getFirstHalfHours();

    AssignmentResult result = new AssignmentResult(
        0,
        $assistant,
        $subject,
        hours,
        $score,
        "Najbolji kandidat za prvi deo velikog predmeta. " + $c.getExplanation()
    );

    $assistant.addLoad($subject.getSemester(), hours);
    update($assistant);

    insert(result);

    System.out.println(
        "[RESULT] "
        + $assistant.getName()
        + " dobija prvi deo velikog predmeta "
        + $subject.getName()
        + " | hours = "
        + hours
        + " | score = "
        + $score
    );
end

rule "Second best candidate gets second part of large subject"
salience -20
when
    $first : AssignmentResult(
        $subject : subject,
        $firstAssistant : assistant
    )

    eval($subject.isLargeSubject())

    $c : Candidate(
        subject == $subject,
        assistant != $firstAssistant,
        $assistant : assistant,
        $score : score
    )

    not Candidate(
        subject == $subject,
        assistant != $firstAssistant,
        score > $score
    )

    not AssignmentResult(
        subject == $subject,
        assistant == $assistant
    )
then
    int hours = $subject.getSecondHalfHours();

    AssignmentResult result = new AssignmentResult(
        0,
        $assistant,
        $subject,
        hours,
        $score,
        "Drugi najbolji kandidat za drugi deo velikog predmeta. " + $c.getExplanation()
    );

    $assistant.addLoad($subject.getSemester(), hours);
    update($assistant);

    insert(result);

    System.out.println(
        "[RESULT] "
        + $assistant.getName()
        + " dobija drugi deo velikog predmeta "
        + $subject.getName()
        + " | hours = "
        + hours
        + " | score = "
        + $score
    );
end

rule "Validate overloaded assistant"
salience -100
when
    $a : Assistant(
        $name : name,
        $targetLoad : targetLoad
    )

    eval($a.getTotalLoad() > $targetLoad)

    not ValidationMessage(
        message == "Asistent " + $name + " je preopterecen."
    )
then
    insert(new ValidationMessage(
        0,
        "WARNING",
        "Asistent " + $name + " je preopterecen."
    ));

    System.out.println(
        "[VALIDATION] Asistent "
        + $name
        + " je preopterecen. Total = "
        + $a.getTotalLoad()
        + ", target = "
        + $targetLoad
    );
end

rule "Validate unassigned subject"
salience -100
when
    $s : Subject(
        $name : name
    )

    not AssignmentResult(
        subject == $s
    )

    not ValidationMessage(
        message == "Predmet " + $name + " nije rasporedjen."
    )
then
    insert(new ValidationMessage(
        0,
        "ERROR",
        "Predmet " + $name + " nije rasporedjen."
    ));

    System.out.println(
        "[VALIDATION] Predmet "
        + $name
        + " nije rasporedjen."
    );
end

rule "Validate assigned subject hours"
salience -100
when
    $s : Subject(
        $name : name,
        $totalHours : totalHours
    )

    $assignedHours : Number()
    from accumulate(
        AssignmentResult(
            subject == $s,
            $hours : assignedHours
        ),
        sum($hours)
    )

    eval($assignedHours.intValue() != $totalHours)

    not ValidationMessage(
        message == "Predmet " + $name + " nema ispravan broj dodeljenih casova."
    )
then
    insert(new ValidationMessage(
        0,
        "ERROR",
        "Predmet " + $name + " nema ispravan broj dodeljenih casova."
    ));

    System.out.println(
        "[VALIDATION] Predmet "
        + $name
        + " ima dodeljeno "
        + $assignedHours
        + " od "
        + $totalHours
        + " casova."
    );
end