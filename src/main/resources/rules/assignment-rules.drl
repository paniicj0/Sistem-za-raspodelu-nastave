package rules

import sbnz.szrn.model.ValidationMessage;
import sbnz.szrn.model.Assistant;
import sbnz.szrn.model.Subject;
import sbnz.szrn.model.Preference;
import sbnz.szrn.model.PreviousAssignment;
import sbnz.szrn.model.SpecificRequest;
import sbnz.szrn.model.SubjectRelation;
import sbnz.szrn.model.Candidate;
import sbnz.szrn.model.AssignmentResult;

query directlyRelatedSubject(Subject $source, Subject $target)
    SubjectRelation(source == $source, target == $target)
end

query relatedSubject(Subject $source, Subject $target)
    (
        directlyRelatedSubject($source, $target;)
    or
        (
            SubjectRelation(source == $source, $middle : target)
            and
            relatedSubject($middle, $target;)
        )
    )
end

query assistantPreviouslyTaught(Assistant $assistant, Subject $subject)
    PreviousAssignment(assistant == $assistant, subject == $subject)
end

query assistantHasRelatedPreviousExperience(Assistant $assistant, Subject $candidateSubject, Subject $previousSubject)
    assistantPreviouslyTaught($assistant, $previousSubject;)
    eval($previousSubject != $candidateSubject)
    relatedSubject($candidateSubject, $previousSubject;)
end

rule "High preference creates candidate"
salience 100
when
    $p : Preference(
        $assistant : assistant,
        $subject : subject,
        grade == 5
    )

    not Candidate(
        assistant == $assistant,
        subject == $subject
    )
then
    Candidate candidate = new Candidate(
        0,
        $assistant,
        $subject,
        50,
        "Visoka preferenca."
    );

    insert(candidate);

    System.out.println(
        "[RULE] High preference creates candidate: "
        + $assistant.getName()
        + " -> "
        + $subject.getName()
    );
end


rule "Medium preference creates candidate"
salience 90
when
    $p : Preference(
        $assistant : assistant,
        $subject : subject,
        grade >= 3,
        grade <= 4
    )

    not Candidate(
        assistant == $assistant,
        subject == $subject
    )
then
    Candidate candidate = new Candidate(
        0,
        $assistant,
        $subject,
        25,
        "Srednja preferenca."
    );

    insert(candidate);

    System.out.println(
        "[RULE] Medium preference creates candidate: "
        + $assistant.getName()
        + " -> "
        + $subject.getName()
    );
end



rule "Low preference fallback creates candidate"
salience 80
when
    $p : Preference(
        $assistant : assistant,
        $subject : subject,
        grade >= 2,
        grade <= 2
    )

    not Candidate(
        subject == $subject
    )

    not Candidate(
        assistant == $assistant,
        subject == $subject
    )
then
    Candidate candidate = new Candidate(
        0,
        $assistant,
        $subject,
        5,
        "Niska preferenca, ali kandidat je ukljucen kao fallback da predmet ne ostane nerasporedjen."
    );

    insert(candidate);

    System.out.println(
        "[RULE] Low preference fallback creates candidate: "
        + $assistant.getName()
        + " -> "
        + $subject.getName()
    );
end

rule "Previous assignment increases score"
salience 50
when
    $c : Candidate(
        previousAssignmentApplied == false,
        $assistant : assistant,
        $subject : subject
    )

    PreviousAssignment(
        assistant == $assistant,
        subject == $subject
    )
then
    modify($c) {
        addScore(20, "Asistent je prethodno drzao predmet."),
        setPreviousAssignmentApplied(true)
    }

    System.out.println(
        "[RULE] Previous assignment increases score: "
        + $assistant.getName()
        + " -> "
        + $subject.getName()
        + " | score = "
        + $c.getScore()
    );
end


rule "Related previous assignment increases score through backward chain"
salience 49
when
    $c : Candidate(
        relatedPreviousAssignmentApplied == false,
        $assistant : assistant,
        $subject : subject
    )

    assistantHasRelatedPreviousExperience($assistant, $subject, $previousSubject;)
then
    modify($c) {
        addScore(12, "Rekurzivni backward-chain query je pronasao prethodno iskustvo na povezanom predmetu."),
        setRelatedPreviousAssignmentApplied(true)
    }

    System.out.println(
        "[RULE] Related previous assignment via backward chain: "
        + $assistant.getName()
        + " | "
        + $previousSubject.getName()
        + " -> "
        + $subject.getName()
        + " | score = "
        + $c.getScore()
    );
end


rule "Overload penalty"
salience 40
when
    $c : Candidate(
        overloadPenaltyApplied == false,
        $assistant : assistant,
        $subject : subject
    )

    eval($assistant.getTotalLoad() + $subject.getTotalHours() > $assistant.getTargetLoad())
then
    modify($c) {
        addScore(-30, "Dodela bi prekoracila ciljano opterecenje."),
        setOverloadPenaltyApplied(true)
    }

    System.out.println(
        "[RULE] Overload penalty: "
        + $assistant.getName()
        + " -> "
        + $subject.getName()
        + " | score = "
        + $c.getScore()
    );
end


rule "Hard load threshold penalty"
salience 39
when
    $c : Candidate(
        hardLoadPenaltyApplied == false,
        $assistant : assistant,
        $subject : subject
    )

    eval($assistant.getTotalLoad() + $subject.getTotalHours() > 30)
then
    modify($c) {
        addScore(-50, "Velika kazna: dodela bi prebacila asistenta preko 30 casova."),
        setHardLoadPenaltyApplied(true)
    }

    System.out.println(
        "[RULE] Hard load threshold penalty: "
        + $assistant.getName()
        + " -> "
        + $subject.getName()
        + " | score = "
        + $c.getScore()
    );
end

rule "Subject count per semester penalty"
salience -9
when
    $c : Candidate(
        subjectCountPenaltyApplied == false,
        $assistant : assistant,
        $subject : subject
    )

    $subjectCount : Number()
    from accumulate(
        AssignmentResult(
            assistant == $assistant,
            subject.semester == $subject.getSemester()
        ),
        count(1)
    )

    eval($subjectCount.intValue() >= 2)
then
    int penalty = $subjectCount.intValue() >= 3 ? -60 : -25;
    String reason = $subjectCount.intValue() >= 3
            ? "Velika kazna: asistent bi imao vise od 3 predmeta u semestru."
            : "Kazna: asistent bi imao vise od 2 predmeta u semestru.";

    modify($c) {
        addScore(penalty, reason),
        setSubjectCountPenaltyApplied(true)
    }

    System.out.println(
        "[RULE] Subject count penalty: "
        + $assistant.getName()
        + " -> "
        + $subject.getName()
        + " | current subjects = "
        + $subjectCount
        + " | penalty = "
        + penalty
        + " | score = "
        + $c.getScore()
    );
end

rule "Best candidate gets small subject"
salience -10
when
    $c : Candidate(
        assigned == false,
        $assistant : assistant,
        $subject : subject,
        $score : score
    )

    eval(!$subject.isLargeSubject())

    $assignedHours : Number()
    from accumulate(
        AssignmentResult(
            subject == $subject,
            $hours : assignedHours
        ),
        sum($hours)
    )

    eval($assignedHours.intValue() < $subject.getTotalHours())

    not Candidate(
        subject == $subject,
        assigned == false,
        score > $score
    )

    not AssignmentResult(
        subject == $subject,
        assistant == $assistant
    )
then
    int hours = $subject.getTotalHours() - $assignedHours.intValue();

    AssignmentResult result = new AssignmentResult(
        0,
        $assistant,
        $subject,
        hours,
        $score,
        "Najbolji kandidat za manji predmet. " + $c.getExplanation()
    );

    modify($assistant) {
        addLoad($subject.getSemester(), hours)
    }

    modify($c) {
        setAssigned(true)
    }

    insert(result);

    System.out.println(
        "[RESULT] "
        + $assistant.getName()
        + " dobija manji predmet "
        + $subject.getName()
        + " | hours = "
        + hours
        + " | score = "
        + $score
    );
end

rule "Best candidate gets first part of large subject"
salience -10
when
    $c : Candidate(
        assigned == false,
        $assistant : assistant,
        $subject : subject,
        $score : score
    )

    eval($subject.isLargeSubject())

    $assignedHours : Number()
    from accumulate(
        AssignmentResult(
            subject == $subject,
            $hours : assignedHours
        ),
        sum($hours)
    )

    eval($assignedHours.intValue() < $subject.getTotalHours())

    not Candidate(
        subject == $subject,
        assigned == false,
        score > $score
    )

    not AssignmentResult(
        subject == $subject,
        assistant == $assistant
    )
then
    int remainingHours = $subject.getTotalHours() - $assignedHours.intValue();
    int hours = Math.min($subject.getFirstHalfHours(), remainingHours);

    AssignmentResult result = new AssignmentResult(
        0,
        $assistant,
        $subject,
        hours,
        $score,
        "Najbolji kandidat za prvi deo velikog predmeta. " + $c.getExplanation()
    );

    modify($assistant) {
        addLoad($subject.getSemester(), hours)
    }

    modify($c) {
        setAssigned(true)
    }

    insert(result);

    System.out.println(
        "[RESULT] "
        + $assistant.getName()
        + " dobija prvi deo velikog predmeta "
        + $subject.getName()
        + " | hours = "
        + hours
        + " | score = "
        + $score
    );
end

rule "Second best candidate gets second part of large subject"
salience -20
when
    $first : AssignmentResult(
        $subject : subject,
        $firstAssistant : assistant
    )

    eval($subject.isLargeSubject())

    $assignedHours : Number()
    from accumulate(
        AssignmentResult(
            subject == $subject,
            $hours : assignedHours
        ),
        sum($hours)
    )

    eval($assignedHours.intValue() < $subject.getTotalHours())

    $c : Candidate(
        assigned == false,
        subject == $subject,
        assistant != $firstAssistant,
        $assistant : assistant,
        $score : score
    )

    not Candidate(
        subject == $subject,
        assigned == false,
        assistant != $firstAssistant,
        score > $score
    )

    not AssignmentResult(
        subject == $subject,
        assistant == $assistant
    )
then
    int remainingHours = $subject.getTotalHours() - $assignedHours.intValue();
    int hours = Math.min($subject.getSecondHalfHours(), remainingHours);

    AssignmentResult result = new AssignmentResult(
        0,
        $assistant,
        $subject,
        hours,
        $score,
        "Drugi najbolji kandidat za drugi deo velikog predmeta. " + $c.getExplanation()
    );

    modify($assistant) {
        addLoad($subject.getSemester(), hours)
    }

    modify($c) {
        setAssigned(true)
    }

    insert(result);

    System.out.println(
        "[RESULT] "
        + $assistant.getName()
        + " dobija drugi deo velikog predmeta "
        + $subject.getName()
        + " | hours = "
        + hours
        + " | score = "
        + $score
    );
end

rule "Validate overloaded assistant"
salience -100
when
    $a : Assistant(
        $name : name,
        $targetLoad : targetLoad
    )

    eval($a.getTotalLoad() > $targetLoad)

    not ValidationMessage(
        message == "Asistent " + $name + " je preopterecen."
    )
then
    insert(new ValidationMessage(
        0,
        "WARNING",
        "Asistent " + $name + " je preopterecen."
    ));

    System.out.println(
        "[VALIDATION] Asistent "
        + $name
        + " je preopterecen. Total = "
        + $a.getTotalLoad()
        + ", target = "
        + $targetLoad
    );
end

rule "Validate unassigned subject"
salience -100
when
    $s : Subject(
        $name : name
    )

    not AssignmentResult(
        subject == $s
    )

    not ValidationMessage(
        message == "Predmet " + $name + " nije rasporedjen."
    )
then
    insert(new ValidationMessage(
        0,
        "ERROR",
        "Predmet " + $name + " nije rasporedjen."
    ));

    System.out.println(
        "[VALIDATION] Predmet "
        + $name
        + " nije rasporedjen."
    );
end

rule "Validate assigned subject hours"
salience -100
when
    $s : Subject(
        $name : name,
        $totalHours : totalHours
    )

    $assignedHours : Number()
    from accumulate(
        AssignmentResult(
            subject == $s,
            $hours : assignedHours
        ),
        sum($hours)
    )

    eval($assignedHours.intValue() != $totalHours)

    not ValidationMessage(
        message == "Predmet " + $name + " nema ispravan broj dodeljenih casova."
    )
then
    insert(new ValidationMessage(
        0,
        "ERROR",
        "Predmet " + $name + " nema ispravan broj dodeljenih casova."
    ));

    System.out.println(
        "[VALIDATION] Predmet "
        + $name
        + " ima dodeljeno "
        + $assignedHours
        + " od "
        + $totalHours
        + " casova."
    );
end


